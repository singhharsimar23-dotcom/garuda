{
  "buildCommand": "cd frontend && npm install && npm run build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__url__=/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/collect",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/easm/scan",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/easm/kev-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/rpz/sync",
      "schedule": "0 5 * * *"
    }
  ]
}
