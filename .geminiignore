# ==============================================================================
# Antigravity & Gemini Context Window Optimization (.antigravityignore / .geminiignore)
# FinOps rules to prevent huge token consumption and context truncation
# ==============================================================================

# --- Version Control & IDE Metadata ---
.git/
.svn/
.hg/
.idea/
.vscode/
.antigravity/

# --- Dependency Lockfiles (Massive Token Sinks) ---
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
composer.lock
Cargo.lock
poetry.lock
Pipfile.lock
uv.lock

# --- Package Managers & Dependencies ---
node_modules/
frontend/node_modules/
vendor/
bower_components/

# --- Build Artifacts, Bundles & Minified Code ---
dist/
frontend/dist/
build/
out/
target/
.next/
.nuxt/
.astro/
.output/
.turbo/
*.min.js
*.min.css
*.bundle.js
*.map

# --- Python Environments & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
wheels/
.installed.cfg
*.egg

# --- Testing, Coverage & Profiling ---
.pytest_cache/
.coverage
htmlcov/
coverage/
.nyc_output/
.tox/
.nox/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# --- Logs & Runtime Temp Files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Large Binary, Media & Database Files ---
*.sqlite
*.sqlite3
*.db
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.bin
*.pt
*.pth
*.onnx
*.weights
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.wav
*.mp3
*.flac
*.zip
*.tar
*.gz
*.rar
*.7z
*.iso
*.pdf
*.wasm

# --- Graphify Visualizers & Large Raw Dumps ---
# Note: graph.json and GRAPH_REPORT.md remain accessible; huge viewer HTMLs are ignored
graphify-out/*.html
*.callflow.html
*.tree.html

# --- Cloud & Deployment Artifacts ---
.vercel/
.wrangler/
.serverless/
.terraform/
*.tfstate
*.tfstate.*
