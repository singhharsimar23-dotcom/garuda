# ==============================================================================
# GARUDA AXIOM-II SERVICE CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Northflank PostgreSQL Database Connection (asyncpg)
# Example: postgresql://user:password@pg-host.northflank.app:5432/garuda_db
NORTHFLANK_DB_URL=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Supabase (Realtime Alerts Mirroring)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Agent Authentication (Shared secret for agent Bearer authentication)
AGENT_API_KEY=

# Telegram Alerting Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq LLM Narrative API (Free Tier)
GROQ_API_KEY=
GROQ_PREFERRED_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-70b-versatile
GROQ_DAILY_LIMIT=5

# Inter-Service Authentication (Service 1 -> Service 2 BRAHMA/DHARMA)
INTER_SERVICE_SECRET=
NORTHFLANK_BRAHMA_URL=

# Upstash Redis (Daily Rate Limits & Token Counters)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Default IAS Thresholds (Starting points before auto-calibration)
DEFAULT_LOG_THRESHOLD=1.5
DEFAULT_MEDIUM_THRESHOLD=3.0
DEFAULT_CRITICAL_THRESHOLD=5.0

# Feature Flags
FEATURE_FLAG_GROQ=true
FEATURE_FLAG_DHARMA=true
FEATURE_FLAG_SUPABASE_REALTIME=true
