{
  "services": [
    {
      "name": "Shodan InternetDB",
      "daily_limit": null,
      "rate": "1 req/sec",
      "auth": "none",
      "endpoint": "https://internetdb.shodan.io/{ip}"
    },
    {
      "name": "Shodan API",
      "daily_limit": null,
      "monthly_query_credits": 100,
      "rate": "1 req/sec",
      "auth": "SHODAN_API_KEY"
    },
    {
      "name": "Censys",
      "daily_limit": null,
      "monthly_limit": 250,
      "rate": "1 req/sec",
      "auth": "CENSYS_API_ID + CENSYS_API_SECRET"
    },
    {
      "name": "VirusTotal",
      "daily_limit": 500,
      "rate": "4 req/min",
      "auth": "VIRUSTOTAL_API_KEY"
    },
    {
      "name": "Robtex",
      "daily_limit": null,
      "hourly_limit": 10,
      "auth": "none"
    },
    {
      "name": "HackerTarget",
      "daily_limit": 100,
      "auth": "none"
    },
    {
      "name": "CISA KEV",
      "daily_limit": null,
      "auth": "none",
      "poll_interval": "6h"
    },
    {
      "name": "NVD CVE API",
      "daily_limit": null,
      "rate_per_30s": 50,
      "auth": "NVD_API_KEY"
    },
    {
      "name": "OTX AlienVault",
      "daily_limit": null,
      "auth": "OTX_API_KEY"
    },
    {
      "name": "URLhaus / MalwareBazaar",
      "daily_limit": null,
      "auth": "URLHAUS_API_KEY"
    }
  ]
}
