# ==============================================================================
# GARUDA CTI PLATFORM - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Supabase (Database & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/garuda

# Redis & Caching (Upstash / Local Redis)
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Celery Task Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI / Threat Narrative Generation (Anthropic Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Threat Intelligence Feeds & OSINT APIs
OTX_API_KEY=your-alienvault-otx-api-key
CIRCL_API_USER=
CIRCL_API_PASSWORD=
URLHAUS_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
SECURITYTRAILS_API_KEY=
WHOISXML_API_KEY=

# Geopolitical Tension & Conflict Monitoring
GDELT_API_KEY=
TENSION_FEED_URL=
CONFLICT_MODE=false
TENSION_THRESHOLD=0.65
CRON_SECRET=your-random-cron-secret-token

# Threat Scoring Thresholds
SCORE_THRESHOLD_LOG=40
SCORE_THRESHOLD_MEDIUM=70
SCORE_THRESHOLD_CRITICAL=85

# Webhook & Notification Alerts
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
