# ==============================================================================
# GARUDA PLATFORM PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SUPABASE INFRASTRUCTURE (Required across all services)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<your-supabase-project>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. INTER-SERVICE AUTHENTICATION & AGENT KEYS
# ------------------------------------------------------------------------------
INTER_SERVICE_SECRET=garuda-secret-production-token-2026
AGENT_API_KEY=garuda-agent-node-secure-token

# ------------------------------------------------------------------------------
# 3. UPSTREAM LLM INFERENCE APIS (UTNE & SENTINEL)
# ------------------------------------------------------------------------------
# Groq API: Free tier 14,400 req/day (llama-3.1-8b-instant / llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_...
GROQ_PREFERRED_MODEL=llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini API (Backup / STIX Intelligence parsing)
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 4. DHARMA AUTONOMOUS BACKEND CREDENTIALS
# ------------------------------------------------------------------------------
# Cloudflare DNS API v4 (For automated Domain Sinkholing)
CLOUDFLARE_API_TOKEN=cf_pat_...
CLOUDFLARE_ZONE_ID=cf_zone_...

# SSH Process Isolation (Paramiko SIGSTOP for monitored Linux hosts)
DHARMA_SSH_HOST=10.0.0.1
DHARMA_SSH_USER=garuda-dharma
DHARMA_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 5. UPSTASH REDIS REST API (SLA Countdowns & Offline Buffering)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://<your-redis>.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ------------------------------------------------------------------------------
# 6. OPERATOR ALERTING (Telegram Bot API)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 7. MICROSERVICE INTER-COMMUNICATION URLS
# ------------------------------------------------------------------------------
AXIOM_SERVICE_URL=https://garuda-axiom-service.onrender.com
BRAHMA_SERVICE_URL=https://garuda-brahma-service.onrender.com
DHARMA_SERVICE_URL=https://garuda-brahma-service.onrender.com
MAYA_SERVICE_URL=https://garuda-brahma-service.onrender.com
KALI_SERVICE_URL=https://garuda-brahma-service.onrender.com
UTNE_SERVICE_URL=https://garuda-utne-service.onrender.com
SENTINEL_SERVICE_URL=https://garuda-sentinel-service.onrender.com

# ------------------------------------------------------------------------------
# 8. OPERATIONAL FLAGS & THRESHOLDS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
CONFLICT_MODE=false
KALI_MCTS_SIMULATIONS=500

# ------------------------------------------------------------------------------
# 9. FRONTEND (Vite / React) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-supabase-project>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_AXIOM_URL=https://garuda-axiom-service.onrender.com
VITE_BRAHMA_URL=https://garuda-brahma-service.onrender.com
VITE_UTNE_URL=https://garuda-utne-service.onrender.com
VITE_SENTINEL_URL=https://garuda-sentinel-service.onrender.com
