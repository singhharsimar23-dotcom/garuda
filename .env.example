# ==============================================================================
# GARUDA CTI PLATFORM - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","https://garuda-ochre.vercel.app"]

# Supabase (Database & Auth)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Redis & Caching (Upstash REST)
UPSTASH_REDIS_REST_URL=https://<your-redis>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# AI Threat Intelligence Narrative Engine (Google Gemini / Anthropic)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Predictive Domain Pre-Registration (Porkbun — Session 12)
PORKBUN_API_KEY=
PORKBUN_API_SECRET=
TAXII_ADMIN_TOKEN=
DOMAIN_REGISTRATION_BUDGET_USD_MONTHLY=50.0

# RAG Attribution Vector Store (Qdrant cloud free tier)
QDRANT_URL=
QDRANT_API_KEY=

# Threat Intelligence Feeds & OSINT APIs
OTX_API_KEY=
URLHAUS_API_KEY=
URLHAUS_TOKEN=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
WHOISXML_API_KEY=

# GitHub Actions Integration (Headless Screenshotting & CertStream Monitor)
GH_TOKEN=
GH_REPO=singhharsimar23-dotcom/garuda

# Geopolitical Conflict Monitoring & Shared Vercel Cron Secret
CONFLICT_MODE=false
TENSION_THRESHOLD=0.65
CRON_SECRET=<run-openssl-rand-hex-32>
TAXII_ADMIN_TOKEN=<run-openssl-rand-hex-32>

# Webhook & Telegram Notification Alerts
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ANY.RUN Sandbox Analysis (Session 13 — free signup at app.any.run)
ANYRUN_API_KEY=

# Canary Document Factory (Session 14)
CANARYTOKENS_WEBHOOK_URL=
GREYNOISE_API_KEY=
