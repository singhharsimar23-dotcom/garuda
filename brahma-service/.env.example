# ==============================================================================
# GARUDA BRAHMA ADVERSARY MODELING SERVICE CONFIGURATION (.env.example)
# ==============================================================================

ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8001

# Northflank PostgreSQL Database Connection (asyncpg)
NORTHFLANK_DB_URL=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Supabase (Realtime & STIX Objects)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Inter-Service Authentication (AXIOM Service 1 <-> BRAHMA Service 2)
INTER_SERVICE_SECRET=
NORTHFLANK_AXIOM_URL=

# AI Threat Intelligence Narrative & Grammar Synthesis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_PREFERRED_MODEL=llama-3.3-70b-versatile
GROQ_GRAMMAR_HOURLY_LIMIT=5

# Threshold Configuration
GRAMMAR_EXPANSION_ENTROPY_THRESHOLD=2.0
ATTRIBUTION_OBSERVATION_THRESHOLD=15
